# dependencies
node_modules/

# build output
dist/
.wrangler/
.mf/
worker-configuration.d.ts

# secrets & local config — NEVER commit
.dev.vars
# built from wrangler.jsonc + .dev.vars on every deploy (scripts/deploy-config.ts)
wrangler.deploy.json
.dev.vars.*
# ...except the placeholder-only examples, at any depth (root + integrator-relay) (#60)
!.dev.vars.example
.env
.env.*
clients/**/secrets.*
clients/**/*.local.json

# local D1 / sqlite
*.sqlite
*.sqlite-*
.wrangler/state/

# test / coverage
coverage/
*.log

# editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Claude Code local settings
.claude/settings.local.json

# discover writes this beside a tuned map instead of overwriting it (#62)
clients/*/field-map.draft.json
# this deployment's own field map, like .dev.vars: tracked, it would split a
# client's history from upstream and stop `git pull` (scripts/update.sh).
# npm install copies in the _example placeholder; a deploy refuses that.
clients/self/field-map.json
# the field check's choices (#112): this deployment's own data, the same way
clients/self/field-picks.json

# the EH before/after diff's snapshot (#157): full employee records, TFN included
eh-snapshot*.json

# the wizard's session log (#83) - may name the client's accounts
setup-wizard-*.log
